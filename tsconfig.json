{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2020",
    "module": "ES2020",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "include": ["web/**/*.js", "web/**/*.d.ts", "src/**/*.ts"],
  "exclude": ["web/tests/**", "web/icons/**", "web/types.js", "web/dist/**"]
}
